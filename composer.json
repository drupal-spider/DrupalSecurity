{
    "name": "mingsong-hu/drupalsecurity",
    "type": "phpcodesniffer-standard",
    "description": "Drupal Security is a library to review security issue of Drupal code.",
    "homepage": "https://github.com/mingsong-hu/DrupalSecurity",
    "support": {
        "issues": "https://github.com/mingsong-hu/DrupalSecurity/issues",
        "source": "https://github.com/mingsong-hu/DrupalSecurity"
    },
    "keywords": ["phpcs", "standards", "code review", "Drupal", "security"],
    "license": "GPL-2.0+",
    "require": {
        "drupal/coder": ">=8.2.0",
        "ext-mbstring": "*",
        "php": ">=5.4.0",
        "phpcsstandards/phpcsutils": ">=1.0.0",
        "squizlabs/php_codesniffer": ">=3.0.0",
        "symfony/yaml": ">=2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": ">= 12.5.7"
    }
}
